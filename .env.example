# ============================================================================
# ENVIRONMENT CONFIGURATION - Copy to .env and fill in actual values
# ============================================================================
# This file documents all available environment variables
# WARNING: Keep .env file with actual credentials out of version control!
# 

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB connection string (local development)
MONGODB_URI=mongodb://localhost:27017/learning_path_ai

# MongoDB connection string (MongoDB Atlas cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/learning_path_ai?retryWrites=true&w=majority

# Database name
DB_NAME=learning_path_ai

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Secret key for JWT token generation (MUST be 32+ characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-minimum-32-characters-long-CHANGE-IN-PRODUCTION

# JWT token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token expiration (in days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# AI/LLM - GOOGLE GEMINI
# ============================================================================
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# Model to use for text generation
RAG_MODEL=models/gemini-2.5-flash

# RAG Pipeline Configuration
RAG_MAX_CONTEXT_CHARS=2000
RAG_MAX_PROMPT_CHARS=8000
RAG_GENERATION_TIMEOUT=30
RAG_MAX_RETRIES=2
RAG_MIN_RESOURCES=1
RAG_MAX_RESOURCES=10

# ============================================================================
# BACKEND SERVER CONFIGURATION
# ============================================================================
# Server host
BACKEND_HOST=0.0.0.0

# Server port
BACKEND_PORT=8000

# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable debug mode (WARNING: DO NOT use in production!)
DEBUG=False

# ============================================================================
# CORS - Cross-Origin Resource Sharing
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ============================================================================
# FRONTEND CONFIGURATION (Vite)
# ============================================================================
# Backend API URL accessible from frontend
VITE_API_URL=http://localhost:8000

# API base path
VITE_API_BASE_PATH=/api

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=100

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.pdf,.txt,.md

# Upload directory path
UPLOAD_DIR=./backend/uploads

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable RAG (Retrieval-Augmented Generation) feature
ENABLE_RAG=true

# Enable adaptive learning engine
ENABLE_ADAPTIVE_LEARNING=true

# Enable YouTube resource import
ENABLE_YOUTUBE_IMPORT=true

# Enable PDF resource import
ENABLE_PDF_IMPORT=true

# ============================================================================
# OPTIONAL: CACHING WITH REDIS
# ============================================================================
# Redis connection string
# REDIS_URL=redis://localhost:6379/0

# Enable Redis caching
# REDIS_ENABLED=true

# Cache TTL for concepts (in seconds)
CONCEPT_CACHE_TTL=3600

# ============================================================================
# OPTIONAL: MONITORING & ERROR TRACKING
# ============================================================================
# Sentry DSN for error tracking and monitoring
# SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ============================================================================
# OPTIONAL: EMAIL NOTIFICATIONS
# ============================================================================
# SMTP server configuration for email notifications
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL=your-email@gmail.com
# SENDER_PASSWORD=your-app-specific-password

# ============================================================================
# TESTING & DEVELOPMENT
# ============================================================================
# Enable test mode (uses mock data instead of real API)
TEST_MODE=false

# Enable hot reload for development
HOT_RELOAD=true# ========================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ========================================

# API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_BASE_PATH=/api

# App Configuration
VITE_APP_NAME=Personalized Learning Path
