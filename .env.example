# ============================================================================
# ENVIRONMENT CONFIGURATION - Copy to .env and fill in actual values
# ============================================================================
# This file documents all available environment variables
# WARNING: Keep .env file with actual credentials out of version control!
# 

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# MongoDB connection string (local development)
MONGODB_URI=mongodb://localhost:27017/learning_path_ai

# MongoDB connection string (MongoDB Atlas cloud)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/learning_path_ai?retryWrites=true&w=majority

# Database name
DB_NAME=learning_path_ai

# ============================================================================
# AUTHENTICATION & SECURITY
# ============================================================================
# Secret key for JWT token generation (MUST be 32+ characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-super-secret-key-minimum-32-characters-long-CHANGE-IN-PRODUCTION

# JWT token expiration time (in minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Optional: comma-separated admin emails that receive admin privileges at login
ADMIN_EMAILS=admin@example.com

# Refresh token expiration (in days)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================================================
# AI/LLM - GOOGLE GEMINI
# ============================================================================
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: multiple Gemini keys for automatic fallback/rotation when one key hits quota.
# Priority order is:
# 1. GEMINI_API_KEY
# 2. GEMINI_API_KEYS (comma or newline separated)
# 3. GEMINI_API_KEY_1, GEMINI_API_KEY_2, ...
# Example:
# GEMINI_API_KEYS=key_1,key_2,key_3
# GEMINI_API_KEY_1=key_1
# GEMINI_API_KEY_2=key_2
GEMINI_API_KEYS=

# Cooldown for a key that hits a hard quota limit before it is retried.
GEMINI_API_KEY_COOLDOWN_SECONDS=300

# Small delay before trying the next key during failover.
GEMINI_API_KEY_RETRY_DELAY_SECONDS=0.5

# Short cooldown for temporary overload errors like 503 UNAVAILABLE.
GEMINI_API_KEY_TRANSIENT_COOLDOWN_SECONDS=15

# Model to use for text generation
RAG_MODEL=models/gemini-2.5-flash

# Optional: question-generation model fallback order when the primary model hits quota.
# The first model remains LESSON_QUESTION_LLM_MODEL (or GEMINI_MODEL if unset).
LESSON_QUESTION_LLM_FALLBACK_MODELS=models/gemini-2.0-flash-lite,models/gemini-2.0-flash

# ============================================================================
# EMBEDDINGS & SEMANTIC RETRIEVAL
# ============================================================================
# Legacy flag. Prefer EMBEDDING_PROVIDER below.
USE_EXTERNAL_EMBEDDING=true

# auto | sentence_transformers | gemini | hash
# For local demo with an available Gemini API key, prefer `gemini`
EMBEDDING_PROVIDER=gemini

# Local embedding model when sentence-transformers is installed
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Remote embedding model when Gemini is enabled
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Semantic chunking defaults for ingestion
RESOURCE_CHUNKING_STRATEGY=semantic
RESOURCE_CHUNK_SIZE=1200
RESOURCE_CHUNK_OVERLAP=180
RESOURCE_MIN_CHUNK_LENGTH=80

# When false, learning path generation returns quickly and lesson recommendations
# are computed lazily the first time a lesson needs them.
LEARNING_PATH_PRECOMPUTE_RECOMMENDATIONS_ON_GENERATE=false

# RAG Pipeline Configuration
RAG_MAX_CONTEXT_CHARS=2000
RAG_MAX_PROMPT_CHARS=8000
RAG_GENERATION_TIMEOUT=30
RAG_MAX_RETRIES=2
RAG_MIN_RESOURCES=1
RAG_MAX_RESOURCES=10

# AI Answer Strategy Configuration
# Ngưỡng điểm để quyết định trả lời trực tiếp từ tài liệu (0.0-1.0)
# Nếu tài liệu có relevance score >= ngưỡng này, sẽ trả lời trực tiếp mà không cần AI
RAG_DIRECT_ANSWER_THRESHOLD=0.75

# Số lượng tài nguyên chất lượng cao tối thiểu để trả lời trực tiếp
# Cần ít nhất N tài liệu với score >= RAG_DIRECT_ANSWER_THRESHOLD
RAG_MIN_HIGH_QUALITY_RESOURCES=2

# ============================================================================
# BACKEND SERVER CONFIGURATION
# ============================================================================
# Server host
BACKEND_HOST=0.0.0.0

# Server port
BACKEND_PORT=8000

# Environment: development, staging, production
ENVIRONMENT=development

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Enable debug mode (WARNING: DO NOT use in production!)
DEBUG=False

# ============================================================================
# CORS - Cross-Origin Resource Sharing
# ============================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# ============================================================================
# FRONTEND CONFIGURATION (Vite)
# ============================================================================
# Backend API URL accessible from frontend
VITE_API_URL=http://localhost:8000

# API base path
VITE_API_BASE_PATH=/api

# ============================================================================
# FILE UPLOAD CONFIGURATION
# ============================================================================
# Maximum file upload size (in MB)
MAX_UPLOAD_SIZE_MB=100

# Allowed file extensions (comma-separated)
ALLOWED_EXTENSIONS=.pdf,.txt,.md

# Upload directory path
UPLOAD_DIR=./backend/uploads

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable RAG (Retrieval-Augmented Generation) feature
ENABLE_RAG=true

# Enable adaptive learning engine
ENABLE_ADAPTIVE_LEARNING=true

# Enable YouTube resource import
ENABLE_YOUTUBE_IMPORT=true

# Enable PDF resource import
ENABLE_PDF_IMPORT=true

# ============================================================================
# OPTIONAL: CACHING WITH REDIS
# ============================================================================
# Redis connection string
# REDIS_URL=redis://localhost:6379/0

# Enable Redis caching
# REDIS_ENABLED=true

# Cache TTL for concepts (in seconds)
CONCEPT_CACHE_TTL=3600

# ============================================================================
# OPTIONAL: MONITORING & ERROR TRACKING
# ============================================================================
# Sentry DSN for error tracking and monitoring
# SENTRY_DSN=https://your-key@sentry.io/your-project-id

# ============================================================================
# OPTIONAL: EMAIL NOTIFICATIONS
# ============================================================================
# SMTP server configuration for email notifications
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SENDER_EMAIL=your-email@gmail.com
# SENDER_PASSWORD=your-app-specific-password

# ============================================================================
# TESTING & DEVELOPMENT
# ============================================================================
# Enable test mode (uses mock data instead of real API)
TEST_MODE=false

# Enable hot reload for development
HOT_RELOAD=true# ========================================
# FRONTEND ENVIRONMENT CONFIGURATION
# ========================================

# API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_BASE_PATH=/api

# App Configuration
VITE_APP_NAME=Personalized Learning Path
