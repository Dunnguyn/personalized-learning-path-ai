# Backend runtime
MONGODB_URI=mongodb://localhost:27017/learning_path_ai
DB_NAME=learning_path_ai
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters-long
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAILS=admin@example.com

# AI providers
GEMINI_API_KEY=
GEMINI_API_KEYS=
GEMINI_API_KEY_COOLDOWN_SECONDS=300
GEMINI_API_KEY_RETRY_DELAY_SECONDS=0.5
GEMINI_API_KEY_TRANSIENT_COOLDOWN_SECONDS=15
RAG_MODEL=models/gemini-2.5-flash
LESSON_QUESTION_LLM_FALLBACK_MODELS=models/gemini-2.0-flash-lite,models/gemini-2.0-flash

# Retrieval and embeddings
EMBEDDING_PROVIDER=gemini
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
RESOURCE_CHUNKING_STRATEGY=semantic
RESOURCE_CHUNK_SIZE=1200
RESOURCE_CHUNK_OVERLAP=180
RESOURCE_MIN_CHUNK_LENGTH=80
LEARNING_PATH_PRECOMPUTE_RECOMMENDATIONS_ON_GENERATE=false

# RAG limits
RAG_MAX_CONTEXT_CHARS=2000
RAG_MAX_PROMPT_CHARS=8000
RAG_GENERATION_TIMEOUT=30
RAG_MAX_RETRIES=2
RAG_MIN_RESOURCES=1
RAG_MAX_RESOURCES=10
RAG_DIRECT_ANSWER_THRESHOLD=0.75
RAG_MIN_HIGH_QUALITY_RESOURCES=2

# Backend server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
UPLOAD_DIR=./backend/uploads

# Feature flags
ENABLE_RAG=true
ENABLE_ADAPTIVE_LEARNING=true
ENABLE_YOUTUBE_IMPORT=true
ENABLE_PDF_IMPORT=true

# Security
ALLOW_INSECURE_EMAIL_ONLY_PASSWORD_RESET=false

# Frontend runtime
VITE_API_URL=http://localhost:8000
VITE_API_BASE_PATH=/api
VITE_APP_NAME=Personalized Learning Path AI
VITE_ENABLE_INSECURE_DIRECT_PASSWORD_RESET=false

# Docker Compose overrides
MONGO_USERNAME=mongodb
MONGO_PASSWORD=replace-with-a-local-dev-password
MONGO_EXPRESS_USERNAME=admin
MONGO_EXPRESS_PASSWORD=replace-with-a-local-dev-password
